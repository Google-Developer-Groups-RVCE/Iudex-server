# Copy this file to .env and fill in your own values.
#
#   cp .env.example .env
#
# .env is gitignored; this template is not, so never put a real secret
# in here. Nothing loads .env automatically - see the README for how to
# load it into your shell before running the server.

# REQUIRED. Secret used to sign JWTs. Must be at least 32 bytes, or the
# server refuses to start. Generate one with:
#
#   openssl rand -base64 48
#
JWT_SECRET=replace-this-with-at-least-32-bytes-of-secret

# Port to listen on.
PORT=8080

# JDBC url for the database. A relative path resolves against the
# working directory, which is app/ when launched through Gradle. The
# url actually used is logged at startup.
IUDEX_DB_URL=jdbc:h2:file:./iudex_db

# Comma separated list of origins allowed to call this API from a
# browser. Leave empty to refuse every cross-origin browser request.
ALLOWED_ORIGINS=http://localhost:5173
